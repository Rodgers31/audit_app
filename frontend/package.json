    "test:admin-shell": "node scripts/verify-node-runtime.cjs && playwright test --config playwright.admin-shell.config.ts",
    "e2e:install": "playwright install --with-deps",
    "test:e2e:legacy": "node scripts/run-legacy-e2e.mjs",
