  "evidence": {
    "nyamira-summary": {
      "source_ref": "cob_annual",
      "pdf_page": 686,
      "printed_page": 652,
      "paragraph": null,
      "anchor": "county stalled-development summary",
      "excerpt": "The County reported one stalled development project as of 30 June 2026, with an estimated value of\nKshs.34.38 million, of which Kshs.26.62 million has already been paid."
    },
    "nyamira-named": {
      "source_ref": "cob_annual",
      "pdf_page": 686,
      "printed_page": 652,
      "paragraph": null,
      "anchor": "named Speaker’s Residence narrative",
      "excerpt": "The stalled project was the County Assembly Speaker’s Residence in Bonyamatuta Ward, which was start-\ned in February 2023. It was estimated at Kshs.34.38 million, with Kshs.26.65 million paid as of 30 June\n2026, and reported at 77 per cent completion. There was no budget allocation to complete the Speaker’s\nresidence, and the County Assembly needs to allocate funds to complete the project."
    },
    "siaya-named": {
      "source_ref": "cob_annual",
      "pdf_page": 758,
      "printed_page": 724,
      "paragraph": null,
      "anchor": "named Nyamonye narrative",
      "excerpt": "The County reported 1 stalled development project as of 30 June 2026, with an estimated value of\nKshs.1.88 million, of which Kshs.3.72 million has already been paid. The stalled project is the completion\nof Nyamonye Juakali, located in Yimbo East, which is currently under investigation."
    },
    "nyamira-oag537": {
      "source_ref": "oag_assembly_2024",
      "pdf_page": 207,
      "printed_page": 193,
      "paragraph": "537",
      "anchor": "Delayed Completion of Speaker’s Residence",
      "excerpt": "537.   Delayed Completion of Speaker’s Residence\n\nThe County Assembly entered into a contract with a local contractor to construct the\nSpeaker’s residence at a contract price amount of Kshs.34,377,805. The contract\ncommenced on 06 February, 2023 with an expected completion date of 06 August, 2024.\nHowever, the project remained incomplete one month after the scheduled completion\ndate and the contract period had not been extended. Further, the performance bond from\na local bank provided by the contractor expired on 7 February, 2024 and had not been\nrenewed.\nReview of Project Status report issued on 28 May, 2024 revealed that the construction\nwas 77% complete and payments totalling Kshs.24,158,208 had been made representing\n70% of contract price. Physical inspection undertaken in September, 2024 revealed that\nthe contactor was on site and construction was still in progress. However, internal and\nexternal finishes, plumbing, tiling, electrical works, interior fittings and painting were still\nnot completed. Further, the contractor used cyprus door frames instead of mahogany\ndoor frames as was specified in the Bills of Quantities.\nIn the circumstances, value for money may not be realized from the delayed works."
    },
    "nyamira-oag533": {
      "source_ref": "oag_assembly_2024",
      "pdf_page": 205,
      "printed_page": 191,
      "paragraph": "533",
      "anchor": "Pending Account Payables",
      "excerpt": "Other disclosures Notes 1 and 2 to the financial statements reflects pending account\npayables and pending staff payables totalling Kshs.67,565,097 and Kshs.52,621,498\nrespectively. The outstanding amounts include payables balance of Kshs.45,231,445 in\nrespect of construction of an office block and Kshs.2,457,540 in respect of construction\nthe Speaker’s residence."
    }
  },
