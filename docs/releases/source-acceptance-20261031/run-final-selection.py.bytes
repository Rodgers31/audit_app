"""Replay the committed selection with a fresh name, preserving old receipts."""
import argparse
from datetime import datetime, timezone
from pathlib import Path
import subprocess
import sys
from uuid import uuid4


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('mode', choices=('normal', 'optimized'))
    args = parser.parse_args()
    directory = Path(__file__).resolve().parent
    helper = directory / 'run-root-tests.py.bytes'
    if not helper.is_file():
        helper = directory / 'run-root-tests.py'
    selection = directory / 'selection.txt'
    if not helper.is_file() or not selection.is_file():
        parser.error('Replay requires the committed root helper and selection.txt together')
    tests = [line.strip() for line in selection.read_text().splitlines() if line.strip()]
    if not tests:
        parser.error('Committed selection is empty')
    name = 'source802-replay-' + args.mode + '-' + datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ') + '-' + uuid4().hex[:8]
    return subprocess.call([sys.executable, str(helper), name, args.mode] + tests)


if __name__ == '__main__':
    raise SystemExit(main())
