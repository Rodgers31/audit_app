"""Apply the real unchanged migration chain only to this owned offline DB."""
import os,json
from sqlalchemy import create_engine,text
from alembic.config import Config
from alembic import command

uri=os.environ['STANDARDS_PG_URL']
assert os.environ['DATABASE_URL']==uri
engine=create_engine(uri)
with engine.begin() as conn:
    row=conn.execute(text("SELECT current_database(),host(inet_server_addr()),inet_server_port(),current_setting('data_directory')")).one()
    assert row==('standards_pending_source_test','127.0.0.1',55492,'/var/lib/postgresql/data'),row
    assert conn.scalar(text("SELECT to_regclass('public.alembic_version')")) is None
    assert not conn.scalars(text("SELECT tablename FROM pg_tables WHERE schemaname='public'")).all()
engine.dispose()
cfg=Config('/work/backend/alembic.ini');cfg.set_main_option('script_location','/work/backend/alembic');command.upgrade(cfg,'head')
engine=create_engine(uri)
with engine.connect() as conn:
    assert conn.scalar(text('SELECT version_num FROM alembic_version'))=='a756b20a0001'
    print(json.dumps({'owned_database':'standards_pending_source_test','port':55492,'alembic_head':'a756b20a0001'}))
engine.dispose()
