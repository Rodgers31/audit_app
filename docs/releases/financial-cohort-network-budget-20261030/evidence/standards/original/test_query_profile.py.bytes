"""Observe real current-source calls; no latency injection or product bypass."""
from collections import Counter
import json, sys, time
from pathlib import Path
import pytest
from sqlalchemy import event, select, func
from models import Extraction, SourceDocument
from social.models import SocialPost, SocialPublication, SocialPostTarget
from social.generation import worker_authority
from test_automatic_cohort_timeout_postgres import ingest_cohort, automatic
from test_cohort_guard import cohort
from native_worker_fixture import restricted


@pytest.fixture
def pg(cohort):
    return cohort


def callsite():
    frame = sys._getframe(1)
    while frame:
        name = frame.f_code.co_filename
        if name.startswith('/work/backend/') and '/tests/' not in name:
            return name.removeprefix('/work/backend/') + ':' + frame.f_code.co_name
        frame = frame.f_back
    return 'framework'


@pytest.mark.parametrize('worker_ports', [False, True])
def test_real_source_round_trips_by_silent_and_changed_phase(request, cohort, tmp_path, monkeypatch, worker_ports):
    factory, engine = request.getfixturevalue('restricted')[:2] if worker_ports else cohort
    capture = worker_authority.capture_worker_authority
    worker_calls = []
    def observed_capture(*args, **kwargs):
        worker_calls.append(1)
        return capture(*args, **kwargs)
    monkeypatch.setattr(worker_authority, 'capture_worker_authority', observed_capture)
    profiles = []
    def measured_run(label, job):
        statements = Counter(); sites = Counter(); duration = Counter(); starts = []
        before_workers = len(worker_calls)
        def before(conn, cursor, statement, params, context, many):
            site = callsite(); key = ' '.join(statement.split())
            starts.append((time.perf_counter(), site, key))
        def after(conn, cursor, statement, params, context, many):
            start, site, key = starts.pop()
            statements[(site, key)] += 1; sites[site] += 1; duration[site] += time.perf_counter() - start
        event.listen(engine, 'before_cursor_execute', before)
        event.listen(engine, 'after_cursor_execute', after)
        started = time.perf_counter()
        try:
            result = automatic(factory, job)
        finally:
            elapsed = time.perf_counter() - started
            event.remove(engine, 'before_cursor_execute', before)
            event.remove(engine, 'after_cursor_execute', after)
        assert result['state'] == 'completed' and result['processed'] == 46 and result['refused'] == 0, result
        record = dict(label=label, worker_ports=worker_ports, elapsed_seconds=elapsed,
                      driver_calls=sum(sites.values()), calls_by_site=dict(sites),
                      driver_seconds_by_site=dict(duration), worker_capture_calls=len(worker_calls)-before_workers,
                      result=result, statements=[dict(site=site, count=count, sql=sql) for (site, sql), count in statements.most_common()])
        profiles.append(record)
        print('INDEPENDENT_PROFILE ' + json.dumps({k:v for k,v in record.items() if k!='statements'}, sort_keys=True))
        return record
    first = ingest_cohort(factory, tmp_path)
    a = measured_run('fresh_baseline', first)
    assert a['result']['baselines'] == 46 and a['result']['drafts_created'] == 0 and a['worker_capture_calls'] == 0
    second = ingest_cohort(factory, tmp_path, retained=True)
    b = measured_run('retained_unchanged', second)
    assert b['result']['unchanged'] == 46 and b['result']['drafts_created'] == 0 and b['worker_capture_calls'] == 0
    third = ingest_cohort(factory, tmp_path, retained=True, correction='Nairobi')
    c = measured_run('retained_one_changed', third)
    assert c['result']['unchanged'] == 45 and c['result']['drafts_created'] == 1 and c['worker_capture_calls'] == 1
    with factory() as db:
        assert db.scalar(select(func.count()).select_from(SocialPost)) == 1
        assert db.scalar(select(func.count()).select_from(SocialPublication)) == 0
        assert db.scalar(select(func.count()).select_from(SocialPostTarget)) == 0
        payloads = dict(source_meta_bytes=[len(json.dumps(x)) for x in db.scalars(select(SourceDocument.meta))],
                        extraction_payload_bytes=[len(json.dumps(x)) for x in db.scalars(select(Extraction.extracted_json))])
    Path('/review/profile-' + ('ports' if worker_ports else 'no-ports') + '.json').write_text(json.dumps(dict(profiles=profiles,payloads=payloads), indent=2) + '\n')
