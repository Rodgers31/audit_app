"""Desired RED: actual current hook under disclosed 130ms driver latency.

The expectation deliberately fails on the reviewed code when only a truthful
partial cohort fits. No deadline, authority or production setting is changed.
"""
from collections import Counter
import json, time
from pathlib import Path
from sqlalchemy import event, select, func
from models import IngestionJob
from social.generation.models import SourceCursor
from social.models import SocialPost, SocialPublication, SocialPostTarget
from social.generation import integration
from seeding.source_observations import read_native_financial_record_ids
from test_automatic_cohort_timeout_postgres import ingest_cohort, automatic
from test_query_profile import pg, cohort, restricted, callsite


def test_retained_baseline_realistic_130ms_completes_46_desired_red(restricted, tmp_path):
    factory, engine, _, _ = restricted
    first = ingest_cohort(factory, tmp_path)
    ids = read_native_financial_record_ids(factory, ingestion_id=first, domain='pending_bills')
    partial = integration.maybe_generate_committed(factory, record_ids=ids[:3], ingestion_id=first, domain='pending_bills')
    assert partial['processed'] == 3 and partial['baselines'] == 3 and partial['drafts_created'] == 0
    job = ingest_cohort(factory, tmp_path, retained=True)
    sites = Counter()
    def measured(conn, cursor, statement, params, context, many):
        sites[callsite()] += 1
        time.sleep(.130)
    event.listen(engine, 'after_cursor_execute', measured)
    start = time.monotonic()
    try:
        outcome = automatic(factory, job)
    finally:
        elapsed = time.monotonic() - start
        event.remove(engine, 'after_cursor_execute', measured)
    with factory() as db:
        root = db.scalar(select(SourceCursor).where(SourceCursor.source_key == 'cob:financial:pending_bills:baseline'))
        stored = dict(source_baseline=root.report_state['financial_baseline'],
                      post_count=db.scalar(select(func.count()).select_from(SocialPost)),
                      publication_count=db.scalar(select(func.count()).select_from(SocialPublication)),
                      target_count=db.scalar(select(func.count()).select_from(SocialPostTarget)))
    observed = dict(latency_per_driver_call_seconds=.130, elapsed_seconds=elapsed, driver_calls=sum(sites.values()),
                    calls_by_site=dict(sites), result=outcome, stored=stored, worker_ports_installed=True)
    Path('/review/realistic-rtt-red.json').write_text(json.dumps(observed, indent=2) + '\n')
    print('REALISTIC_RTT_RED ' + json.dumps(observed, sort_keys=True))
    assert stored == dict(source_baseline=1, post_count=0, publication_count=0, target_count=0)
    assert outcome['state'] == 'failed' and outcome['reason'] == 'GENERATION_DEADLINE_EXCEEDED'
    assert 0 < outcome['processed'] < 46 and outcome['drafts_created'] == 0
    # Requirement under review: a whole eligible cohort within the existing bound.
    assert outcome['state'] == 'completed' and outcome['processed'] == 46, observed
