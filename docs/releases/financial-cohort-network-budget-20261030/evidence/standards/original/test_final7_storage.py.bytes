from datetime import date
from types import SimpleNamespace as N
import pytest
from social.generation.service import controls,established_financial_source
from social.service import SocialError

@pytest.mark.parametrize('target',['controls','existing_marker'])
def test_existing_first_path_keeps_unsupported_storage_refusal_before_reads(target):
    reads=[]
    db=N(bind=N(dialect=N(name='unsupported')),scalar=lambda *a,**kw:reads.append(1) or N())
    with pytest.raises(SocialError,match='GENERATION_STORAGE_UNSUPPORTED'):
        if target=='controls':controls(db,lock=True)
        else:
            observation=N(source_type='cob',evidence_version=1,financial=N(native_domain='pending_bills',
                period_start=date(2025,7,1),period_end=date(2026,6,30),published_on=date(2026,9,4)))
            established_financial_source(db,observation,initialize=True)
    assert reads==[]
