import React from 'react';
import {act,cleanup,render,screen,within} from '@testing-library/react';
import {QueryClient,QueryClientProvider} from '@tanstack/react-query';
import {AxiosError,AxiosHeaders,CanceledError,type InternalAxiosRequestConfig} from 'axios';
import api from '@/lib/api/axios';
import Overview from '@/app/admin/page';
let mockActor:string|null='actor-A';
let mockToken:string|null='token-A';
let mockAdmin=true;
let mockSession=async()=>({data:{session:mockToken?{access_token:mockToken}:null}});
jest.mock('@/lib/supabase/client',()=>({createClient:()=>({auth:{getSession:()=>mockSession()}})}));
jest.mock('@/lib/auth/AuthProvider',()=>({useAuth:()=>({user:mockActor?{id:mockActor}:null})}));
jest.mock('@/lib/auth/admin',()=>({useAdmin:()=>({isAdmin:mockAdmin,isLoading:false})}));
const NOW=new Date('2026-10-31T12:00:00Z').valueOf();
const original=api.defaults.adapter;
let xhr:jest.SpyInstance;let errorLog:jest.SpyInstance;let unexpectedFetch:jest.Mock;
const originalFetch=Object.getOwnPropertyDescriptor(globalThis,'fetch');
const clients:QueryClient[]=[];
beforeEach(()=>{jest.useFakeTimers();jest.setSystemTime(NOW);mockActor='actor-A';mockAdmin=true;mockToken='token-A';mockSession=async()=>({data:{session:mockToken?{access_token:mockToken}:null}});unexpectedFetch=jest.fn().mockRejectedValue(new Error('Unexpected network'));Object.defineProperty(globalThis,'fetch',{configurable:true,writable:true,value:unexpectedFetch});xhr=jest.spyOn(XMLHttpRequest.prototype,'open').mockImplementation(()=>{throw new Error('Unexpected XHR')});errorLog=jest.spyOn(console,'error').mockImplementation(()=>undefined);});
afterEach(()=>{cleanup();for(const client of clients.splice(0))client.clear();api.defaults.adapter=original;expect(unexpectedFetch).not.toHaveBeenCalled();expect(xhr).not.toHaveBeenCalled();xhr.mockRestore();errorLog.mockRestore();if(originalFetch)Object.defineProperty(globalThis,'fetch',originalFetch);else Reflect.deleteProperty(globalThis,'fetch');jest.useRealTimers();});
function response(config:InternalAxiosRequestConfig,status=200,data:any={ok:true},headers:any={}){return {config,status,data,headers,statusText:String(status)};}
function refuse(config:InternalAxiosRequestConfig,header:any='1',status=503){throw new AxiosError('capacity refusal',AxiosError.ERR_BAD_RESPONSE,config,undefined,response(config,status,{detail:'REQUEST_CAPACITY_EXCEEDED'},header===undefined?{}:{'Retry-After':header}));}
async function tick(ms:number){await act(async()=>{await jest.advanceTimersByTimeAsync(ms)});}

describe('independent real Axios capacity boundaries',()=>{
 test.each([NaN,Infinity,-Infinity,-1,true,false,[],['1'],['1','2'],{},null,'','NaN','Infinity','-0','+1','1.0','1e0','0x1','1, 2','1\n','1\r\n','\u00a01','１','١','4','004','999','1000','Fri, 31 Oct 2026 12:00:01 GMT'])('refuses malformed or outside-contract header %p',async header=>{
  let calls=0;api.defaults.adapter=async config=>{calls++;return refuse(config,header)};const result=api.get('/admin/private').then(()=>null,e=>e);await jest.runAllTimersAsync();expect((await result).response.status).toBe(503);expect(calls).toBe(1);expect(jest.getTimerCount()).toBe(0);
 });
 test.each([['0',1500],['1',1500],['2',2000],['3',3000],[' \t2\t',2000],['003',3000],['000',1500]] as const)('honors finite header %s with base minimum',async(header,delay)=>{
  const times:number[]=[];api.defaults.adapter=async config=>{times.push(Date.now());if(times.length===1)return refuse(config,header);return response(config)};const result=api.get('/safe');await jest.advanceTimersByTimeAsync(delay-1);expect(times).toHaveLength(1);await jest.advanceTimersByTimeAsync(1);expect((await result).status).toBe(200);expect(times[1]-times[0]).toBe(delay);
 });
 test.each(['0','1','3'])('caps repeated503 header%s at exactly3 dispatches',async header=>{
  const times:number[]=[];api.defaults.adapter=async config=>{times.push(Date.now());return refuse(config,header)};const result=api.get('/safe').catch(e=>e);await jest.runAllTimersAsync();expect((await result).response.status).toBe(503);expect(times).toHaveLength(3);expect(times[2]-times[0]).toBe(header==='3'?6000:4500);
 });
 test.each(['post','put','patch','delete','options'])('does not replay %s',async method=>{let calls=0;api.defaults.adapter=async config=>{calls++;return refuse(config)};const result=api.request({method,url:'/mutation',data:{exact:'unchanged'}}).catch(e=>e);await jest.runAllTimersAsync();expect((await result).response.status).toBe(503);expect(calls).toBe(1);});
 test('three-attempt cap remains one budget when status switches503→502→503',async()=>{let calls=0;api.defaults.adapter=async config=>{calls++;return refuse(config,'1',calls===2?502:503)};const result=api.get('/mixed').catch(e=>e);await jest.runAllTimersAsync();expect((await result).response.status).toBe(503);expect(calls).toBe(3);});
 test('HEAD retries; casing of actual AxiosHeaders is immaterial',async()=>{let calls=0;api.defaults.adapter=async config=>{calls++;if(calls===1)throw new AxiosError('HTTP503',AxiosError.ERR_BAD_RESPONSE,config,undefined,response(config,503,{},new AxiosHeaders({'rEtRy-AfTeR':'1'})));return response(config)};const result=api.head('/head');await jest.runAllTimersAsync();expect((await result).status).toBe(200);expect(calls).toBe(2);});
 test('does not reinterpret ordinary404/429 with valid Retry-After',async()=>{for(const status of [401,403,404,429]){let calls=0;api.defaults.adapter=async config=>{calls++;return refuse(config,'1',status)};const result=api.get('/not-capacity').catch(e=>e);await jest.runAllTimersAsync();expect((await result).response.status).toBe(status);expect(calls).toBe(1);}});
 test('pre-abort dispatches zero adapters',async()=>{let calls=0;api.defaults.adapter=async config=>{calls++;return response(config)};const ctl=new AbortController();ctl.abort();const result=await api.get('/aborted',{signal:ctl.signal}).catch(e=>e);expect(result.code).toBe(AxiosError.ERR_CANCELED);expect(calls).toBe(0);});
 test('cancellation retires exactly its backoff, leaving independent request live',async()=>{const calls:Record<string,number>={};api.defaults.adapter=async config=>{const u=config.url!;calls[u]=(calls[u]??0)+1;if(calls[u]===1)return refuse(config);return response(config,200,{url:u})};const ctl=new AbortController();const a=api.get('/cancel',{signal:ctl.signal}).catch(e=>e);const b=api.get('/continue');await jest.advanceTimersByTimeAsync(100);ctl.abort();await jest.runAllTimersAsync();expect((await a).code).toBe(AxiosError.ERR_CANCELED);expect((await b).data).toEqual({url:'/continue'});expect(calls).toEqual({'/cancel':1,'/continue':2});expect(jest.getTimerCount()).toBe(0);});
 test('cancellation during asynchronous session retrieval prevents adapter dispatch',async()=>{let release!:()=>void;mockSession=()=>new Promise(resolve=>{release=()=>resolve({data:{session:{access_token:'token-A'}}})});let calls=0;api.defaults.adapter=async config=>{calls++;return response(config)};const ctl=new AbortController();const result=api.get('/pending-auth',{signal:ctl.signal}).catch(e=>e);await Promise.resolve();await Promise.resolve();ctl.abort();release();expect((await result).code).toBe(AxiosError.ERR_CANCELED);expect(calls).toBe(0);});
 test('preserves exact params, headers, signal and successful evidence payload',async()=>{const payload=Object.freeze({zero:0,missing:null,amount:'86899380000.000',unicode:'Nairobi – fedha',source:{page:17},notes:[]});const captured:any[]=[];const ctl=new AbortController();api.defaults.adapter=async config=>{captured.push({params:config.params,cache:config.headers.get('Cache-Control'),trace:config.headers.get('X-Review'),signal:config.signal});if(captured.length===1)return refuse(config,'1');return response(config,200,payload)};const result=api.get('/exact',{params:{page:1,as_at:'2026-06-30'},headers:{'Cache-Control':'no-store','X-Review':'owned'},signal:ctl.signal});await jest.runAllTimersAsync();expect((await result).data).toBe(payload);expect(captured).toEqual(Array(2).fill({params:{page:1,as_at:'2026-06-30'},cache:'no-store',trace:'owned',signal:ctl.signal}));});
 test('fresh same-session token is reacquired on retry',async()=>{const tokens:any[]=[];api.defaults.adapter=async config=>{tokens.push(config.headers.get('Authorization'));if(tokens.length===1)return refuse(config);return response(config)};const result=api.get('/refresh');await jest.advanceTimersByTimeAsync(0);mockToken='token-A-refreshed';await jest.runAllTimersAsync();await result;expect(tokens).toEqual(['Bearer token-A','Bearer token-A-refreshed']);});
});

const payloads:Record<string,any>={
 '/admin/ingestion-jobs/stats/summary':{total_jobs:2,completed:2,failed:0,running:0,pending:0,completed_with_errors:0,total_items_processed:9,total_items_created:2,total_items_updated:7,domains:{audits:2}},
 '/admin/etl/schedule/summary':{timestamp:'2026-10-31T11:59:00Z',running_today:1,skipping_today:5,total_sources:6,efficiency:{vs_fixed_schedule:'calendar only'},sources_to_run:[{source:'oag',reason:'calendar'}]},
 '/admin/etl/health':{timestamp:'2026-10-31T11:59:00Z',scheduler_status:'healthy',plan_status:'available'},
 '/admin/users/stats':{total_users:11,admin_users:2,new_last_7_days:1,new_last_30_days:3},
 '/admin/audit-log':{entries:[],total:0,page:1,page_size:5,has_more:false,snapshot_id:0,as_of:'2026-10-31T11:59:00Z'},
 '/admin/ingestion-jobs':{jobs:[],total:0,page:1,page_size:5,has_more:false},
 '/admin/social/system/status':{publishing_enabled:false,worker:{state:'unavailable',heartbeat_at:null,last_scan_at:null},queue_counts:{pending:0}},
};
function mount(){const client=new QueryClient({defaultOptions:{queries:{retry:false,gcTime:0,refetchOnWindowFocus:false}}});clients.push(client);const view=render(<QueryClientProvider client={client}><Overview/></QueryClientProvider>);return {client,...view,rerenderOverview:()=>view.rerender(<QueryClientProvider client={client}><Overview/></QueryClientProvider>)};}
async function expectRecovered(){expect(screen.getByRole('link',{name:/Manage people and access/})).toHaveTextContent('11 accounts · 2 administrators');expect(screen.getByRole('link',{name:/Check data updates/})).toHaveTextContent('2 jobs in the last 7 days');expect(screen.getByRole('link',{name:/Review social drafts/})).toHaveTextContent('Publishing paused. Worker evidence: unavailable.');expect(screen.getByText('No actions recorded in this view.')).toBeInTheDocument();expect(screen.getByText('1 of 6 sources due by calendar.')).toBeInTheDocument();expect(screen.getByText('Calendar calculation: available.')).toBeInTheDocument();expect(screen.queryByText(/Recent failures could not be checked/)).not.toBeInTheDocument();expect(screen.getByRole('button',{name:'Refresh overview'})).toBeEnabled();}
describe('actual Overview + QueryClient + actual Axios adapter',()=>{
 test('all seven concurrent real queries recover temporary503 automatically without refresh',async()=>{const calls:Record<string,number>={};api.defaults.adapter=async config=>{const u=config.url!;calls[u]=(calls[u]??0)+1;if(calls[u]===1)return refuse(config,'1');return response(config,200,payloads[u])};const {client}=mount();await tick(0);expect(Object.keys(calls).sort()).toEqual(Object.keys(payloads).sort());expect(Object.values(calls)).toEqual(Array(7).fill(1));expect(screen.getByRole('button',{name:'Refresh overview'})).toBeDisabled();await tick(1499);expect(Object.values(calls)).toEqual(Array(7).fill(1));await tick(2);await expectRecovered();expect(Object.values(calls)).toEqual(Array(7).fill(2));expect(client.getQueryCache().getAll()).toHaveLength(7);expect(client.getQueryCache().getAll().every(q=>q.state.status==='success')).toBe(true);});
 test('permanent503, malformed instruction and malformed recovered payload stay unavailable',async()=>{const calls:Record<string,number>={};api.defaults.adapter=async config=>{const u=config.url!;calls[u]=(calls[u]??0)+1;if(u==='/admin/users/stats')return refuse(config,undefined);if(u==='/admin/social/system/status')return refuse(config,'tomorrow');if(calls[u]===1)return refuse(config,'1');return response(config,200,u==='/admin/ingestion-jobs/stats/summary'?{...payloads[u],total_jobs:NaN}:payloads[u])};mount();await tick(1501);const people=screen.getByRole('link',{name:/Manage people and access/}),social=screen.getByRole('link',{name:/Review social drafts/}),updates=screen.getByRole('link',{name:/Check data updates/});for(const card of [people,social,updates])expect(within(card).getByText(/Evidence unavailable/)).toBeInTheDocument();expect(people).not.toHaveTextContent('11 accounts');expect(calls['/admin/users/stats']).toBe(1);expect(calls['/admin/social/system/status']).toBe(1);expect(calls['/admin/ingestion-jobs/stats/summary']).toBe(2);expect(screen.getByText('No actions recorded in this view.')).toBeInTheDocument();});
 test('actor switch cancels every old503 backoff and isolates new actor data/token',async()=>{const calls:{url:string;token:any;signal:any}[]=[];api.defaults.adapter=async config=>{calls.push({url:config.url!,token:config.headers.get('Authorization'),signal:config.signal});if(config.headers.get('Authorization')==='Bearer token-A')return refuse(config);return response(config,200,payloads[config.url!])};const view=mount();await tick(0);expect(calls).toHaveLength(7);mockActor='actor-B';mockToken='token-B';view.rerenderOverview();await tick(0);await tick(3001);await expectRecovered();expect(calls).toHaveLength(14);expect(calls.slice(0,7).every(c=>c.signal.aborted)).toBe(true);expect(calls.filter(c=>c.token==='Bearer token-A')).toHaveLength(7);expect(view.client.getQueryCache().getAll().every(q=>q.queryKey.includes('actor-B'))).toBe(true);});
 test('auth revocation aborts all old503 work and never retries after session disappears',async()=>{const calls:InternalAxiosRequestConfig[]=[];api.defaults.adapter=async config=>{calls.push(config);return refuse(config)};const view=mount();await tick(0);expect(calls).toHaveLength(7);mockAdmin=false;mockActor=null;mockToken=null;view.rerenderOverview();await tick(5000);expect(calls).toHaveLength(7);expect(calls.every(c=>c.signal?.aborted)).toBe(true);expect(screen.getByText('Admin access required.')).toBeInTheDocument();expect(screen.queryByRole('link',{name:/Manage people and access/})).not.toBeInTheDocument();});
 test('unmount aborts pending503 work without any replay',async()=>{const calls:InternalAxiosRequestConfig[]=[];api.defaults.adapter=async config=>{calls.push(config);return refuse(config)};const view=mount();await tick(0);expect(calls).toHaveLength(7);view.unmount();await tick(5000);expect(calls).toHaveLength(7);expect(calls.every(c=>c.signal?.aborted)).toBe(true);});
});
