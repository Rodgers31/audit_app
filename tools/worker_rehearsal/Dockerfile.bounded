# Opt-in local fixture only; never used by a production deployment.
# Resolve and record BASE_IMAGE's local ID before building; the runner requires
# the resulting exact image ID and never pulls it implicitly.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-17 postgresql-contrib-17 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10001 fixture && useradd -u 10001 -g 10001 -M fixture \
    && mkdir /state && chown 10001:10001 /state
USER 10001:10001
WORKDIR /app
ENTRYPOINT ["python", "-B", "/harness/bounded_boot.py"]
