# Production Dockerfile for Backend
FROM python:3.12-slim as builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    pkg-config \
    libpq-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy and install requirements
COPY requirements.txt security-constraints.txt ./
RUN python -m pip install --no-cache-dir --upgrade "pip==26.2.2" \
    && python -m pip wheel --no-cache-dir --no-deps --wheel-dir /app/wheels -r requirements.txt


# Production image
FROM python:3.12-slim

WORKDIR /app

# Create non-root user with a writable home directory.
# ``-m -d /home/appuser`` is required because gunicorn's control
# server (and various other libs) write small files under ``$HOME``
# at boot — without a real home dir gunicorn fails with
# ``Permission denied: '/home/appuser'`` and the master exits.
RUN groupadd -r appuser \
    && useradd -r -g appuser -m -d /home/appuser -s /bin/bash appuser

# Install runtime dependencies
# Debian packages ffprobe in ffmpeg; only bounded local inspection uses it.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    ffmpeg \
    && /usr/bin/ffprobe -version >/dev/null \
    && rm -rf /var/lib/apt/lists/*

# Copy wheels from builder
COPY --from=builder /app/wheels /wheels
COPY --from=builder /app/requirements.txt .
COPY --from=builder /app/security-constraints.txt .

# Install wheels
RUN python -m pip install --no-cache-dir --upgrade "pip==26.2.2" \
    && python -m pip install --no-cache-dir -c security-constraints.txt /wheels/*

# Copy application code
COPY --chown=appuser:appuser . .

# Create necessary directories
RUN mkdir -p uploads logs data && chown -R appuser:appuser uploads logs data

# Switch to non-root user
USER appuser

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV SOCIAL_MEDIA_FFPROBE_PATH=/usr/bin/ffprobe
ENV ENVIRONMENT=production

# Expose the default port so platforms that auto-detect from EXPOSE
# (Render, Railway, Fly.io) still see 8000 when ``$PORT`` isn't set.
# At runtime we bind to ``$PORT`` if the platform set one — see CMD.
EXPOSE 8000

# Health check — uses the same ``$PORT`` env var as the server bind so
# it works whether the platform sets PORT or not.
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/health || exit 1

# Run with Gunicorn for production.
#
# Two things make this CMD slightly unusual:
#
# 1. One worker is explicit: request admission is a process-local budget
#    qualified for this allocation. Scaling workers/instances needs a new
#    admission qualification. Forwarded-address rewriting is disabled so a
#    caller cannot choose a limiter identity through forwarding headers.
#    Socket peers share a coarse budget; this is not end-user IP fairness.
#
# 2. The bind address uses ``${PORT:-8000}`` so the server listens on
#    whatever port the host expects. Render in particular sets
#    ``PORT=10000`` by default and runs a port scan against that
#    address; binding to a hardcoded 8000 would make the deploy fail
#    with ``no open ports detected``. The stdlib launcher preserves that
#    fallback and execs Gunicorn directly with supervision disabled.
# The stdlib launcher execs this exact web argv when supervision is OFF
# (the default). ON owns one web group plus one fixed social child.
CMD ["python", "-m", "social_worker_supervisor"]
